PORT=3000
NODE_ENV=development

# Supabase PROPIO de NAVES (proyecto naves, servicio bd en EasyPanel).
# NAVES no comparte base con ningún otro sistema.
SUPABASE_URL=https://bdnaves.netcloudnetworking.cloud
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Valida tokens HS256 heredados y firma las URLs efímeras de archivos.
SUPABASE_JWT_SECRET=

# Dirección INTERNA de Kong (red de Docker), para que las consultas del backend
# no salgan a internet. En producción: http://naves_bd-kong-1:8000. Al arrancar
# se prueba; si no responde en 3 s se usa SUPABASE_URL (GET /api/health dice
# cuál quedó en `supabase`). Vacía = SUPABASE_URL.
SUPABASE_INTERNAL_URL=

# Cifrado del correo institucional real de los participantes (32 bytes en hex o base64)
PII_ENCRYPTION_KEY=

# Orígenes permitidos, separados por coma
CORS_ORIGINS=https://naves-inalde.com

# SMTP (Zoho): recuperación de clave y avisos
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Pausa entre correos de un envío masivo, en ms, para no chocar con los límites de Zoho (por defecto 600)
EMAIL_DELAY_MS=600
# SOLO PARA PRUEBAS: si tiene valor, TODOS los correos van a esta bandeja con el
# destinatario real en el asunto. En producción debe estar vacía o no existir.
EMAIL_REDIRECT_TO=

# Dominio público: base de TODOS los enlaces que salen por correo (sin barra final)
FRONTEND_URL=https://naves-inalde.com

# Sello de las actas firmadas. Si falta, se deriva de SUPABASE_JWT_SECRET; conviene definirla.
ACTAS_FIRMA_SECRET=

# IA (opcional). Sin la llave, las funciones de IA dicen que no está configurada.
ANTHROPIC_API_KEY=
# Comentada a propósito: si existe vacía, se pierde el modelo por defecto del código.
# ANTHROPIC_MODEL=
